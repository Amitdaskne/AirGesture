<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#000000" android:padding="2dp">
    
    <androidx.camera.view.PreviewView
        android:id="@+id/overlayPreview"
        android:layout_width="120dp" android:layout_height="160dp" />
        
    <TextView android:id="@+id/overlayStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Waiting..." android:textColor="#FFF" android:textSize="10sp"
        android:gravity="center" android:background="#80000000"/>
</LinearLayout>
